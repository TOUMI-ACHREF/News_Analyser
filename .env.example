# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=news_analyser

# API
API_HOST=0.0.0.0
API_PORT=8000

# Scraping
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
MAX_ARTICLES_PER_SOURCE=30
MAX_ARCHIVE_DAYS=120
ARCHIVE_EMPTY_STREAK=5
# Global headed Playwright (lemonde/lepoint/france24 force headed anyway)
SCRAPE_HEADED=false

# Toxicity ML
TOXICITY_MODEL_NAME=textdetox/xlmr-base-toxicity-classifier
TOXICITY_MAX_LENGTH=512
TOXICITY_TOXIC_THRESHOLD=0.5
TOXICITY_HIGHLY_THRESHOLD=0.8
